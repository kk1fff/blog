---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
---
<Base title="Search"><h1>Search</h1><input id="query" class="search" placeholder="Search posts" autofocus /><section class="post-list" id="results"><article class="card">Start typing to search posts.</article></section><script>const input=document.querySelector('#query'); const results=document.querySelector('#results'); const escapeHtml=(value)=>value.replace(/[&<>"']/g,(character)=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;' })[character]); const posts=await fetch('/search-index.json').then((response)=>response.json()); input?.addEventListener('input',()=>{const terms=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean); const matched=posts.filter((post)=>terms.every((term)=>`${post.title} ${post.description} ${post.tags.join(' ')} ${post.body}`.toLowerCase().includes(term))); results.innerHTML=matched.map((post)=>`<article class="card"><div class="meta">${new Date(post.publishedAt).toLocaleDateString()}</div><h2><a href="/posts/${encodeURIComponent(post.slug)}">${escapeHtml(post.title)}</a></h2><p>${escapeHtml(post.description)}</p></article>`).join('') || '<article class="card">No matching posts.</article>';});</script></Base>
