---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { listPosts, readSettings } from "@agentic-blog/content-contract";
const [posts, settings] = await Promise.all([listPosts(), readSettings()]);
---
<Base title={settings.site.title}><p class="meta">{posts.length} published {posts.length === 1 ? "post" : "posts"}</p><section class="post-list">{posts.map((post) => <PostCard post={post} />)}</section></Base>
