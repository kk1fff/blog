---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { allTags, listRenderablePosts } from "@agentic-blog/content-contract";
export async function getStaticPaths() { const posts = await listRenderablePosts(); return allTags(posts).map((tag) => ({ params: { tag } })); }
const tag = Astro.params.tag!;
const posts = (await listRenderablePosts()).filter((post) => post.tags.includes(tag));
---
<Base title={`#${tag}`}><h1>#{tag}</h1><section class="post-list">{posts.map((post) => <PostCard post={post} />)}</section></Base>
