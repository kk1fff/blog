---
import Base from "../../layouts/Base.astro";
import { allTags, listRenderablePosts } from "@agentic-blog/content-contract";
const tags = allTags(await listRenderablePosts());
---
<Base title="Tags"><h1>Tags</h1><div class="tags">{tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}</div></Base>
