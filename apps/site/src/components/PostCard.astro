---
import type { Post } from "@agentic-blog/content-contract";
const { post, commentsEnabled = false } = Astro.props as { post: Post; commentsEnabled?: boolean };
const date = new Date(post.publishedAt).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
---
<article class="card">
  <div class="meta"><time datetime={post.publishedAt}>{date}</time></div>
  <div class="post-copy">
    <h3><a href={`/posts/${post.slug}`}>{post.title}</a></h3>
    <p>{post.description}</p>
    <div class="tags">{post.tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}</div>
    {commentsEnabled && <a class="discussion-bar" href={`/posts/${post.slug}#comments-heading`} data-discussion-bar data-discussion-path={`/posts/${post.slug}`} aria-label={`View discussion for ${post.title}`}><span>Discussion</span><span data-discussion-count>View discussion</span></a>}
  </div>
</article>
