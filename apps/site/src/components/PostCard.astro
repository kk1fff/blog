---
import type { Post } from "@agentic-blog/content-contract";
const { post } = Astro.props as { post: Post };
const date = new Date(post.publishedAt).toLocaleDateString(undefined, { year: "numeric", month: "long", day: "numeric" });
---
<article class="card"><div class="meta"><time datetime={post.publishedAt}>{date}</time></div><h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p><div class="tags">{post.tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}</div></article>
